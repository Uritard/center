<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yjh.gateway.module.gateway.dao.TSysParamDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yjh.gateway.module.gateway.entity.TSysParam">
        <id column="param_id" jdbcType="INTEGER" property="paramId" />
        <result column="param_code" jdbcType="VARCHAR" property="paramCode" />
        <result column="param_type" jdbcType="INTEGER" property="paramType" />
        <result column="param_name" jdbcType="VARCHAR" property="paramName" />
        <result column="content" jdbcType="VARCHAR" property="content" />
        <result column="remark" jdbcType="VARCHAR" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        param_id,param_code, param_type, param_name, content, remark
    </sql>



    <select id="selectByPrimaryCode" resultType="com.yjh.gateway.module.gateway.entity.TSysParam">
        select *
        from t_sys_param
        where param_code = 'isDecode'
    </select>


    <select id="selectByPrimaryUkey" resultType="com.yjh.gateway.module.gateway.entity.TSysParam">
        select *
        from t_sys_param
        where param_code = 'isUkey'
    </select>
</mapper>
