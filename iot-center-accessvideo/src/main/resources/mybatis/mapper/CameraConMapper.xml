<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yjh.accessvideo.module.control.dao.CameraConDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yjh.accessvideo.module.control.entity.CameraConInfo">
        <id column="camera_id" jdbcType="BIGINT" property="cameraId" />
        <result column="channel_num" jdbcType="INTEGER" property="channelNum" />
        <result column="preset_id" jdbcType="BIGINT" property="presetId" />
        <result column="preset_num" jdbcType="INTEGER" property="presetNum" />
        <result column="record_id" jdbcType="BIGINT" property="recordId" />
        <result column="record_ip" jdbcType="VARCHAR" property="recordIp" />
        <result column="user_name" jdbcType="VARCHAR" property="userName" />
        <result column="pwd" jdbcType="VARCHAR" property="pwd" />
        <result column="rtsp_port" jdbcType="INTEGER" property="rtspPort" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        camera_id, channel_num, preset_id, preset_num, record_id, record_ip, user_name, pwd, rtsp_port
    </sql>

    <select id="selectConInfo" parameterType="java.lang.Long" resultType="com.yjh.accessvideo.module.control.entity.CameraConInfo">
        SELECT
        a.camera_id,
        a.channel_num,
        a.camera_type,
        b.preset_id,
        b.preset_num,
        c.record_id,
        c.record_ip,
        c.user_name,
        c.pwd,
        c.rtsp_port
        FROM t_camera_info a
        LEFT JOIN t_camera_preset b ON a.camera_id = b.camera_id
        LEFT JOIN t_camera_recorder c ON a.record_id = c.record_id
        WHERE 1 = 1
        <if test="cameraId != null and cameraId != ''"> and a.camera_id = #{cameraId, jdbcType=BIGINT}</if>
        <if test="presetId != null and presetId != ''"> and b.preset_id = #{presetId, jdbcType=BIGINT}</if>
        limit 1
    </select>

    <select id="selectStatusInfo" parameterType="java.lang.Long" resultType="com.yjh.accessvideo.module.control.entity.CameraConInfo">
        SELECT
        a.camera_id,
        a.channel_num,
        a.camera_type,
        c.record_id,
        c.record_ip,
        c.user_name,
        c.pwd,
        c.rtsp_port
        FROM t_camera_info a
        LEFT JOIN t_camera_recorder c ON a.record_id = c.record_id
        WHERE 1 = 1
        <if test="cameraId != null and cameraId != ''"> and a.camera_id = #{cameraId, jdbcType=BIGINT}</if>
    </select>



</mapper>
