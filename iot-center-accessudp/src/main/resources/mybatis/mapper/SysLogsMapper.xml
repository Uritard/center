<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yjh.accessudp.module.device.dao.SysLogsDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yjh.accessudp.module.device.entity.SysLogs">
        <id column="log_id" jdbcType="VARCHAR" property="logId" />
        <result column="log_type" jdbcType="VARCHAR" property="logType" />
        <result column="ip" jdbcType="VARCHAR" property="ip" />
        <result column="title" jdbcType="VARCHAR" property="title" />
        <result column="state" jdbcType="INTEGER" property="state" />
        <result column="content" jdbcType="VARCHAR" property="content" />
        <result column="user_id" jdbcType="BIGINT" property="userId" />
        <result column="user_name" jdbcType="VARCHAR" property="userName" />
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        log_id, log_type, ip, title, state, content, user_id, user_name, create_time
    </sql>

    <select id="selectByPrimaryId" parameterType="java.lang.String" resultType="com.yjh.accessudp.module.device.entity.SysLogs">
        select
        a.log_id,
        a.log_type,
        a.ip,
        a.title,
        a.state,
        a.content,
        a.user_id,
        a.user_name,
        a.create_time
        from sys_logs a
        where 1 = 1
            and a.log_id = #{logId, jdbcType=VARCHAR}
        limit 1
    </select>

</mapper>
