<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yjh.platform.module.user.dao.AlarmShieldDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yjh.platform.module.user.entity.AlarmShield">
    <result column="id" property="id" />
        <result column="shield_id" property="shieldId" />
        <result column="create_user_id" property="createUserId" />
        <result column="end_time" property="endTime" />
        <result column="shield_type" property="shieldType" />
        <result column="warn_content" property="warnContent" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        shield_id, create_user_id, end_time, shield_type, warn_content, create_time
    </sql>

    <select id="selectByWarnCount" resultType="com.yjh.platform.module.user.entity.AlarmShield">
        select * from alarm_shield
        where warn_count like concat('%',#{warnCount},'%')
        and shield_type = #{shieldType}
        order by end_time asc
        limit 1
    </select>
    <select id="select" resultType="com.yjh.platform.module.user.entity.AlarmShield">
        select * from alarm_shield
    </select>

    <insert id="add" useGeneratedKeys="true" keyProperty="id" parameterType="com.yjh.platform.module.user.entity.AlarmShield">
        INSERT INTO `alarm_shield` (
        `shield_id`,
        `create_user_id`,
        `end_time`,
        `shield_type`,
        `warn_content` )
        VALUES
            (
            #{AlarmShield.shieldId, jdbcType=BIGINT},
            #{AlarmShield.createUserId, jdbcType=BIGINT},
            #{AlarmShield.endTime, jdbcType=TIMESTAMP},
            #{AlarmShield.shieldType, jdbcType=INTEGER},
            #{AlarmShield.warnCount, jdbcType=VARCHAR}
            );
    </insert>

    <delete id="delete" >
        delete from `alarm_shield` where id =#{id}
    </delete>

    <update id="update" >
        update `alarm_shield`
        <set>
            end_time = #{endTime, jdbcType=TIMESTAMP}
        </set>
        where id =#{id}
    </update>

</mapper>
