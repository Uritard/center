<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yjh.platform.module.user.dao.CommonMenuDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yjh.platform.module.user.entity.CommonMenu">
    <result column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="menu_code" property="menuCode" />
        <result column="menu_name" property="menuName" />
        <result column="path" property="path" />
        <result column="img" property="img" />
        <result column="sort" property="sort" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        user_id, menu_code, menu_name, img, `path`,sort
    </sql>

    <insert id="add" useGeneratedKeys="true" keyProperty="id" parameterType="com.yjh.platform.module.user.entity.CommonMenu">
        INSERT INTO `common_menu` (
            `user_id`,
            `menu_code`,
            `menu_name`,
            `img`,
            `path`,
            `sort` )
        VALUES
            (
                #{userId, jdbcType=BIGINT},
                #{menuCode, jdbcType=VARCHAR},
                #{menuName, jdbcType=VARCHAR},
                #{img, jdbcType=VARCHAR},
                #{path, jdbcType=VARCHAR},
                #{sort, jdbcType=VARCHAR}
            );
    </insert>

    <insert id="batchAdd" useGeneratedKeys="true" keyProperty="id" parameterType="com.yjh.platform.module.user.entity.CommonMenu">
        INSERT INTO `common_menu` (
            `user_id`,
            `menu_code`,
            `menu_name`,
            `img`,
            `path`,
            `sort` )
        VALUES
               <foreach collection="list" separator="," item="CommonMenu">
            (
                #{CommonMenu.userId, jdbcType=BIGINT},
                #{CommonMenu.menuCode, jdbcType=VARCHAR},
                #{CommonMenu.menuName, jdbcType=VARCHAR},
                #{CommonMenu.img, jdbcType=VARCHAR},
                #{CommonMenu.path, jdbcType=VARCHAR},
                #{CommonMenu.sort, jdbcType=VARCHAR}
            )
               </foreach>
    </insert>

    <select id="selectByUserId" resultType="com.yjh.platform.module.user.entity.CommonMenu">
        select * from common_menu where user_id = #{userId}
    </select>

    <delete id="deleteByUserId">
        delete from common_menu where user_id = #{userId}
    </delete>

    <select id="selectNewCommonMenu" resultType="com.yjh.platform.module.user.entity.CommonMenu">
        select
        *,
        #{userId} as userId
        from common_menu_conf
        where sort &lt;= 4
    </select>

    <select id="selectCommonMenuConf" resultType="com.yjh.platform.module.user.entity.CommonMenu">
        select
            *
        from common_menu_conf
    </select>
</mapper>
