spring:
    application:
        name: agitatedserver

server:
    port: 8081

hystrix:
 command:
  default:
   execution:
    isolation:
     thread:
      timeoutInMilliseconds: 10000

eureka:
   instance:
       #将IP注册到Eureka Server上，而如果不配置就是机器的主机名
       prefer-ip-address: true
       #eureka注册中心的url link
       status-page-url-path: /actuator/info
       #健康检查的url
       health-check-url-path: /actuator/health
       hostname: 127.0.0.1
   client:
       #是否注册到注册中心
       register-with-eureka: false
       #是否从注册中心拉取注册服务列表
       fetch-registry: false
       serviceUrl:
         defaultZone: http://${eureka.instance.hostname}:${server.port}/eureka/

management:
  endpoints:
    web:
      exposure:
        include: "*"
  endpoint:
    health:
      show-details: ALWAYS